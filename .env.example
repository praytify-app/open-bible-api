# Database
DATABASE_URL=postgresql://bible:bible@localhost:5433/open_bible

# API Security
ADMIN_TOKEN=your-admin-token-here

# Server
PORT=3100
HOST=0.0.0.0

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# Rate limiting for direct traffic: requests per hour per client IP.
# (RATE_LIMIT is still read as a legacy alias.)
RATE_LIMIT_MAX=1000

# Shared secret the Praytify gateway sends as X-Gateway-Token. Requests that
# present it skip the per-IP limiter, because the gateway enforces its own
# per-key and per-user quotas. Leave empty when not behind the gateway.
GATEWAY_TOKEN=

# Run drizzle migrations (under an advisory lock) before the server listens.
MIGRATE_ON_BOOT=false

# Postgres pool size and per-statement timeout (ms, 0 disables).
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000

# api.bible API key (for copyrighted versions: ESV, NIV, NLT, NASB, NKJV)
# Get a free key at https://scripture.api.bible/
API_BIBLE_KEY=

# ESV Bible API (Crossway) — get key at https://api.esv.org/
ESV_API_TOKEN=

# Where the seeder caches eBible.org zips (default: ./.cache/ebible). Point it
# at a mounted volume or tmpfs when the container root filesystem is read-only.
# EBIBLE_CACHE_DIR=
