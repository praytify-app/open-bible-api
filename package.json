{
  "name": "open-bible-api",
  "version": "1.5.1",
  "description": "Open-source REST API serving Bible data",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "seed": "DB_STATEMENT_TIMEOUT_MS=0 tsx --env-file=.env --expose-gc src/seeder/cli.ts",
    "seed:sample": "DB_STATEMENT_TIMEOUT_MS=0 tsx --env-file-if-exists=.env src/seeder/cli.ts seed-sample",
    "search:build": "tsx --env-file-if-exists=.env scripts/build-search-infra.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "bible",
    "api",
    "rest",
    "hono"
  ],
  "author": "Open Bible API Contributors",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@12.11.2",
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/core": "^0.5.43",
    "@scalar/hono-api-reference": "^0.12.12",
    "@scalar/types": "^0.23.2",
    "commander": "^15.0.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
